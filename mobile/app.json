{
  "expo": {
    "name": "AiiGrow",
    "slug": "aiigrow",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "vn.aiilab.aiigrow",
      "buildNumber": "9",
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "vn.aiilab.aiigrow",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-nen.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      ["expo-font", { "fonts": [
        "./node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
        "./node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
        "./node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf"
      ] }],
      [
        "expo-splash-screen",
        { "image": "./assets/splash-icon.png", "imageWidth": 200, "resizeMode": "contain", "backgroundColor": "#16776F" }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AiiGrow dùng camera để quét mã ghép máy và để Con chụp ảnh bằng chứng nhiệm vụ. Ảnh chỉ gia đình xem.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "web": { "favicon": "./assets/favicon.png" },
    "scheme": "aiigrow",
    "experiments": { "typedRoutes": true }
  }
}
