{
  "expo": {
    "name": "AiiGrow",
    "slug": "aiigrow",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "vn.aiilab.aiigrow",
      "buildNumber": "5",
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "vn.aiilab.aiigrow",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "AiiGrow dùng camera để quét mã ghép máy và để Con chụp ảnh bằng chứng nhiệm vụ. Ảnh chỉ gia đình xem.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "web": { "favicon": "./assets/favicon.png" },
    "scheme": "aiigrow",
    "experiments": { "typedRoutes": true }
  }
}
