{
  "expo": {
    "name": "AiiGrow",
    "slug": "aiigrow",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "vn.aiilab.aiigrow",
      "buildNumber": "67",
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "vn.aiilab.aiigrow",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-nen.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-image",
      ["expo-font", { "fonts": [
        "./assets/fonts/BeVietnamPro_400Regular.ttf",
        "./assets/fonts/BeVietnamPro_600SemiBold.ttf",
        "./assets/fonts/BeVietnamPro_700Bold.ttf",
        "./assets/fonts/BeVietnamPro_800ExtraBold.ttf",
        "./assets/fonts/Fraunces_600SemiBold.ttf",
        "./assets/fonts/Fraunces_700Bold.ttf"
      ] }],
      [
        "expo-splash-screen",
        { "image": "./assets/splash-icon.png", "imageWidth": 200, "resizeMode": "contain", "backgroundColor": "#ECE4D9" }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "AiiGrow dùng camera để Ba Mẹ chụp ảnh đại diện cho con. Ảnh chỉ gia đình xem.",
          "photosPermission": "AiiGrow cần đọc ảnh bạn chọn làm ảnh đại diện cho con. Ảnh chỉ gia đình xem.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AiiGrow dùng camera để quét mã ghép máy và để Con chụp ảnh bằng chứng nhiệm vụ. Ảnh chỉ gia đình xem.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "web": { "favicon": "./assets/favicon.png", "lang": "vi", "themeColor": "#ECE4D9" },
    "scheme": "aiigrow",
    "experiments": { "typedRoutes": true }
  }
}
