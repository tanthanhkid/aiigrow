{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "iad1"
  ],
  "installCommand": "pnpm install --frozen-lockfile && cd ../mobile && npm ci",
  "buildCommand": "pnpm build:app && next build",
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/cron/don-kiem-toan",
      "schedule": "0 19 * * *"
    }
  ]
}
