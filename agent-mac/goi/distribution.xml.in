<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>AiiGrow</title>
  <welcome file="chao.html" mime-type="text/html"/>
  <license file="dieu-khoan.html" mime-type="text/html"/>
  <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
  <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
  <volume-check><allowed-os-versions><os-version min="13.0"/></allowed-os-versions></volume-check>
  <choices-outline><line choice="vn.aiilab.aiigrow"/></choices-outline>
  <choice id="vn.aiilab.aiigrow" title="AiiGrow" visible="false">
    <pkg-ref id="vn.aiilab.aiigrow.pkg"/>
  </choice>
  <pkg-ref id="vn.aiilab.aiigrow.pkg" version="@BAN@" onConclusion="none">aiigrow-thanh-phan.pkg</pkg-ref>
</installer-gui-script>
