#!/bin/bash
# Cập nhật đè: dừng bản cũ đang chạy; giữ nguyên config.json.
# Nhãn trình gỡ từ xa còn sót: chỉ gỡ khi job ĐÃ xong (không có PID) — job go đang chạy mà remove là giết trình gỡ giữa chừng.
LC=/bin/launchctl
if ! "$LC" list vn.aiilab.aiigrow.go 2>/dev/null | /usr/bin/grep -q '"PID"'; then
  "$LC" remove vn.aiilab.aiigrow.go >/dev/null 2>&1 || true
fi
"$LC" bootout system/vn.aiilab.aiigrow.daemon >/dev/null 2>&1 || true
for uid in $(/bin/bash "$(/usr/bin/dirname "$0")/phien-gui.sh"); do
  "$LC" bootout "gui/$uid/vn.aiilab.aiigrow.tray" >/dev/null 2>&1 || true
done
exit 0
