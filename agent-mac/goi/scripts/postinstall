#!/bin/bash
# Chạy với quyền root bởi installer. Tạo thư mục, chép plist, nạp daemon và tray.
set -u
THU_MUC="/Library/Application Support/AiiGrow"
LOG="/Library/Logs/AiiGrow"
APP="/Applications/AiiGrow.app"
RES="$APP/Contents/Resources"

DA_GO="/var/db/aiigrow-da-go"                  # go-cai.sh / daemon (gỡ từ xa) ghi: máy đã bị gỡ
DANG_CAP_NHAT="/var/run/aiigrow-capnhat"       # job tự cập nhật ghi: lần cài này do daemon tự chạy
if [ -f "$DA_GO" ]; then
  if [ -f "$DANG_CAP_NHAT" ]; then
    # Tự cập nhật chạy đè lên máy vừa bị gỡ từ xa: không nạp lại daemon/tray, dọn phần gói vừa chép.
    /bin/rm -rf "$APP" "$THU_MUC/cap-nhat"
    /bin/launchctl bootout system/vn.aiilab.aiigrow.daemon >/dev/null 2>&1 || true
    exit 0
  fi
  /bin/rm -f "$DA_GO"                          # Ba Mẹ chủ động cài lại sau khi gỡ: bình thường
fi

/bin/mkdir -p "$THU_MUC" "$LOG"
/usr/sbin/chown root:wheel "$THU_MUC" "$LOG"
/bin/chmod 0700 "$THU_MUC"
/bin/chmod 0755 "$LOG"
[ -f "$THU_MUC/config.json" ] && /bin/chmod 0600 "$THU_MUC/config.json"

for p in vn.aiilab.aiigrow.daemon:/Library/LaunchDaemons vn.aiilab.aiigrow.tray:/Library/LaunchAgents; do
  ten="${p%%:*}"; dich="${p#*:}"
  /bin/cp "$RES/$ten.plist" "$dich/$ten.plist"
  /usr/sbin/chown root:wheel "$dich/$ten.plist"
  /bin/chmod 0644 "$dich/$ten.plist"
done

/bin/launchctl remove vn.aiilab.aiigrow.go >/dev/null 2>&1 || true      # nhãn trình gỡ từ xa còn sót
/bin/launchctl bootout system/vn.aiilab.aiigrow.daemon >/dev/null 2>&1 || true
/bin/launchctl bootstrap system /Library/LaunchDaemons/vn.aiilab.aiigrow.daemon.plist || true
/bin/launchctl enable system/vn.aiilab.aiigrow.daemon >/dev/null 2>&1 || true

# Tray vào MỌI phiên GUI đang có (preinstall bootout tray của mọi uid): console user + chủ các tiến trình loginwindow (uid >= 500).
CON_USER=$(/usr/bin/stat -f %Su /dev/console 2>/dev/null || true)
UIDS=""
if [ -n "$CON_USER" ] && [ "$CON_USER" != "root" ] && [ "$CON_USER" != "loginwindow" ]; then
  UIDS="$(/usr/bin/id -u "$CON_USER" 2>/dev/null)"
fi
UIDS="$UIDS $(/bin/ps -axo uid=,comm= | /usr/bin/awk '/\/loginwindow$/ && $1 >= 500 {print $1}')"
for CON_UID in $(printf '%s\n' $UIDS | /usr/bin/sort -un); do
  [ -n "$CON_UID" ] || continue
  /bin/launchctl bootout "gui/$CON_UID/vn.aiilab.aiigrow.tray" >/dev/null 2>&1 || true
  /bin/launchctl bootstrap "gui/$CON_UID" /Library/LaunchAgents/vn.aiilab.aiigrow.tray.plist || \
    /bin/launchctl asuser "$CON_UID" /bin/launchctl load /Library/LaunchAgents/vn.aiilab.aiigrow.tray.plist || true
done
exit 0
