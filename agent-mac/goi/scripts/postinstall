#!/bin/bash
# Chạy với quyền root bởi installer. Tạo thư mục, chép plist, nạp daemon và tray.
set -u
# AIIGROW_GOC (mặc định rỗng = gốc /) và AIIGROW_LAUNCHCTL chỉ để thử logic phân nhánh trên thư mục tạm, không cần root.
GOC="${AIIGROW_GOC:-}"
LAUNCHCTL="${AIIGROW_LAUNCHCTL:-/bin/launchctl}"
THU_MUC="$GOC/Library/Application Support/AiiGrow"
LOG="$GOC/Library/Logs/AiiGrow"
APP="$GOC/Applications/AiiGrow.app"
RES="$APP/Contents/Resources"

DA_GO="$GOC/var/db/aiigrow-da-go"                  # go-cai.sh / daemon (gỡ từ xa) ghi: máy đã bị gỡ
DANG_CAP_NHAT="$GOC/var/run/aiigrow-capnhat"   # job tự cập nhật ghi PID của sh job (DuongDan.dangCapNhat)
GO_CAI="$GOC/var/run/aiigrow-go-cai"          # go-cai.sh ghi PID của mình suốt lúc chạy (DuongDan.goCaiDangChay)
# PID trong tệp $1 còn sống VÀ dòng lệnh khớp $2 — PID sót đã bị tiến trình khác dùng lại thì không tính.
pidSong() {
  p=$(/bin/cat "$1" 2>/dev/null || true)
  case "$p" in ''|*[!0-9]*) return 1 ;; esac
  /bin/kill -0 "$p" 2>/dev/null && /bin/ps -p "$p" -o command= 2>/dev/null | /usr/bin/grep -q "$2"
}
if [ -f "$DA_GO" ]; then
  # Cài tự động (sh job cập nhật còn sống), hoặc go-cai.sh còn chạy (nó giết job sau 5 phút nhưng installd có thể cài tiếp) ⇒ máy đang/đã gỡ.
  if pidSong "$DANG_CAP_NHAT" 'vn\.aiilab\.aiigrow\.capnhat' || pidSong "$GO_CAI" 'go-cai'; then
    # Tự cập nhật chạy đè lên máy vừa bị gỡ: không nạp lại daemon/tray, dọn phần gói vừa chép.
    /bin/rm -rf "$APP" "$THU_MUC/cap-nhat"
    "$LAUNCHCTL" bootout system/vn.aiilab.aiigrow.daemon >/dev/null 2>&1 || true
    # plist trỏ vào app vừa xoá: gỡ luôn (go-cai.sh có bị ngắt thì launchd cũng không chạy hụt mỗi lần khởi động)
    /bin/rm -f "$GOC/Library/LaunchDaemons/vn.aiilab.aiigrow.daemon.plist" "$GOC/Library/LaunchAgents/vn.aiilab.aiigrow.tray.plist"
    exit 0
  fi
  /bin/rm -f "$DA_GO"                          # Ba Mẹ chủ động cài lại sau khi gỡ: bình thường
fi

/bin/mkdir -p "$THU_MUC" "$LOG"
/usr/sbin/chown root:wheel "$THU_MUC" "$LOG"
/bin/chmod 0700 "$THU_MUC"
/bin/chmod 0755 "$LOG"
[ -f "$THU_MUC/config.json" ] && /bin/chmod 0600 "$THU_MUC/config.json"

for p in vn.aiilab.aiigrow.daemon:$GOC/Library/LaunchDaemons vn.aiilab.aiigrow.tray:$GOC/Library/LaunchAgents; do
  ten="${p%%:*}"; dich="${p#*:}"
  /bin/cp "$RES/$ten.plist" "$dich/$ten.plist"
  /usr/sbin/chown root:wheel "$dich/$ten.plist"
  /bin/chmod 0644 "$dich/$ten.plist"
done

# nhãn trình gỡ từ xa còn sót: chỉ gỡ khi job đã xong (không có PID)
"$LAUNCHCTL" list vn.aiilab.aiigrow.go 2>/dev/null | /usr/bin/grep -q '"PID"' || "$LAUNCHCTL" remove vn.aiilab.aiigrow.go >/dev/null 2>&1 || true
"$LAUNCHCTL" bootout system/vn.aiilab.aiigrow.daemon >/dev/null 2>&1 || true
"$LAUNCHCTL" bootstrap system "$GOC/Library/LaunchDaemons/vn.aiilab.aiigrow.daemon.plist" || true
"$LAUNCHCTL" enable system/vn.aiilab.aiigrow.daemon >/dev/null 2>&1 || true

# Tray vào MỌI phiên GUI đang có (preinstall bootout tray của mọi uid): console user + chủ các tiến trình loginwindow (uid >= 500).
CON_USER=$(/usr/bin/stat -f %Su /dev/console 2>/dev/null || true)
UIDS=""
if [ -n "$CON_USER" ] && [ "$CON_USER" != "root" ] && [ "$CON_USER" != "loginwindow" ]; then
  UIDS="$(/usr/bin/id -u "$CON_USER" 2>/dev/null)"
fi
UIDS="$UIDS $(/bin/ps -axo uid=,comm= | /usr/bin/awk '/\/loginwindow$/ && $1 >= 500 {print $1}')"
for CON_UID in $(printf '%s\n' $UIDS | /usr/bin/sort -un); do
  [ -n "$CON_UID" ] || continue
  "$LAUNCHCTL" bootout "gui/$CON_UID/vn.aiilab.aiigrow.tray" >/dev/null 2>&1 || true
  "$LAUNCHCTL" bootstrap "gui/$CON_UID" "$GOC/Library/LaunchAgents/vn.aiilab.aiigrow.tray.plist" || \
    "$LAUNCHCTL" asuser "$CON_UID" "$LAUNCHCTL" load "$GOC/Library/LaunchAgents/vn.aiilab.aiigrow.tray.plist" || true
done
exit 0
